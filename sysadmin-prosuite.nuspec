    <file src="ProSuite-Hub\README.md" target="docs\ProSuite-Hub\README.md" />
    <file src="SysAdmin-Tools\README.md" target="docs\SysAdmin-Tools\README.md" />
    <file
      src="SysAdmin-Tools\ADCS-Management-Tools\README.md"
